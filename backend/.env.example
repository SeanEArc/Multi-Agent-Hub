# Optional: copy to backend/.env. Defaults work without this file.
# No API keys or CLI login tokens are required or stored by this app.
# Must be a loopback address; the app refuses to start otherwise.
HUB_HOST=127.0.0.1
HUB_PORT=8765
HUB_RELOAD=false
HUB_LOG_LEVEL=info
HUB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
HUB_CLAUDE_PERMISSION_MODE=acceptEdits

# Omit to use backend/data/hub.db, resolved independently of the working directory.
# For a custom location, use an absolute path, for example:
# HUB_DATABASE_URL=sqlite:///C:/path/to/hub.db

# The API token is generated on first start and kept in backend/data/token (never put it here).
# To move the file, set HUB_TOKEN_FILE for both the backend and the Vite dev server:
# HUB_TOKEN_FILE=C:/path/to/token

# Sessions' git worktrees (one folder each). Default: %LOCALAPPDATA%\MultiAgentHub\worktrees.
# Keep it outside any repository: Claude Code reads the CLAUDE.md files in every folder above where it runs.
# HUB_WORKTREES_DIR=D:/hub-worktrees

# Development only: try handoff with the real CLIs. Every turn by the listed agents (claude, codex)
# runs normally, then ends as if the usage limit was reached. Real usage is spent. Leave unset normally.
# HUB_SIMULATE_LIMIT=claude

# Test-only opt-in: set HUB_LIVE_CLAUDE=1 in the shell, not here.
# The live test reads the process environment and uses real subscription usage.
