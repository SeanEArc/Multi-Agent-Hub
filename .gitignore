# Local environment settings; keep safe, documented examples.
.env
.env.*
!.env.example
!.env.*.example

# Python environments, caches, packaging and coverage.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# Temp folders from agents running pytest with --basetemp (they can be unreadable, owned by a sandbox user).
.pytest-*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# JavaScript dependencies and generated output.
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Local session history, prompts, raw events and SQLite sidecars.
/backend/data/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log

# Personal Claude Code settings and agent worktrees; the shared .claude/settings.json stays tracked.
.claude/settings.local.json
.claude/worktrees/

# Machine-local editor and OS files.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
